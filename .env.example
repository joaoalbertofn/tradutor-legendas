# Obrigatório: Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcional: Modelo Gemini prioritário (padrão: cadeia automática gemini-3.5-flash-lite → 3.5-flash → 3.1-flash-lite → 3.6-flash → 3.8-flash)
GEMINI_MODEL=

# Opcional (Recomendado para produção na Vercel): Upstash Redis
# Usado para o contador global de legendas traduzidas e limite de 3 legendas/dia por IP.
# Sem essas variáveis, o app usa fallback automático em localStorage (contador) e memória (rate limit).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional (Segurança em produção): segredo aleatório para assinatura HMAC das sessões
# Se omitido, usa a própria GEMINI_API_KEY como segredo derivado no servidor.
SESSION_SECRET=

# Opcional: teto global diário de emergência na plataforma inteira (padrão: 150 legendas/dia no Redis)
GLOBAL_DAILY_SUBTITLE_LIMIT=150
