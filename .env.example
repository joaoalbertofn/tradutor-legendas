# Obrigatório: Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcional: Modelo Gemini prioritário (padrão: cadeia automática gemini-3.5-flash-lite → 3.5-flash → 3.1-flash-lite → 3.6-flash → 3.8-flash)
GEMINI_MODEL=

# Opcional (Recomendado para produção na Vercel): Upstash Redis
# Usado para o contador global de legendas traduzidas e limite de 3 legendas/dia por IP.
# Sem essas variáveis, o app usa fallback automático em localStorage (contador) e memória (rate limit).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional (Segurança em produção): segredo aleatório para assinatura HMAC das sessões
# Se omitido, usa a própria GEMINI_API_KEY como segredo derivado no servidor.
SESSION_SECRET=

# Opcional: teto global diário de emergência na plataforma inteira (padrão: 150 legendas/dia no Redis)
GLOBAL_DAILY_SUBTITLE_LIMIT=150

# Obrigatório: Autenticação com Clerk (https://dashboard.clerk.com/)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Obrigatório para pagamentos avulsos: Mercado Pago Checkout Pro (https://www.mercadopago.com.br/developers)
MERCADOPAGO_ACCESS_TOKEN=

# URL pública da aplicação (usada em back_urls e notification_url do Mercado Pago)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional (Telemetria, Créditos e Pagamentos): Supabase
# Persistência das tabelas user_credits, payment_transactions e translation_logs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Obrigatório para acessar o painel /admin/logs: senha simples de administrador
ADMIN_SECRET=

# Opcional: cotação USD → BRL exibida no painel de telemetria (padrão: 5.80)
USD_TO_BRL_RATE=5.80
